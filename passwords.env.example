# Copy this file to passwords.env (gitignored) and fill in real values.
# Keep the real passwords in 1Password too. Never commit passwords.env.
# Use long, random passwords (1Password generate, 20+ chars).

PW_CATALOG=''

# One entry per document: ID|SUBDIR|FRIENDLY NAME|DESCRIPTION|PASSWORD
#   ID       opaque folder name, generate with: openssl rand -hex 4
#   SUBDIR   folder under sources/ holding the plaintext index.html
# Friendly names and descriptions are shown only inside the encrypted catalog.
DOCS=(
  "REPLACE_ID|REPLACE_SUBDIR|Friendly Name|Short description.|REPLACE_PASSWORD"
)
